<view class="page">
  <view class="seg">
    <view class="it {{tab === 'tasks' ? 'on' : ''}}" data-t="tasks" bindtap="switchTab">任务</view>
    <view class="it {{tab === 'logs' ? 'on' : ''}} gold" data-t="logs" bindtap="switchTab">操作日志</view>
  </view>

  <block wx:if="{{tab === 'tasks'}}">
    <view class="add-row">
      <input class="add-input" placeholder="添加竞赛任务…" value="{{input}}" bindinput="onInput" confirm-type="done" bindconfirm="addTask" />
      <view class="btn btn-primary add-btn" bindtap="addTask">添加</view>
    </view>

    <view class="task-list" wx:if="{{!loading}}">
      <view class="trow {{item.done ? 'done' : ''}}" wx:for="{{tasks}}" wx:key="id"
            data-id="{{item.id}}" data-done="{{item.done}}" data-title="{{item.title}}" bindtap="toggleTask">
        <view class="tick {{item.done ? 'on' : ''}}">{{item.done ? '✓' : ''}}</view>
        <view class="ttitle">{{item.title}}</view>
      </view>
      <view class="empty" wx:if="{{!tasks.length}}">还没有任务，添加一个吧</view>
    </view>
  </block>

  <block wx:else>
    <view class="log-list" wx:if="{{!loading}}">
      <view class="lrow" wx:for="{{logs}}" wx:key="index">
        <text class="lt">{{item.text}}</text>
        <text class="lat">{{item.at}}</text>
      </view>
      <view class="empty" wx:if="{{!logs.length}}">暂无操作记录</view>
    </view>
  </block>

  <view class="loading" wx:if="{{loading}}">加载中…</view>
</view>
