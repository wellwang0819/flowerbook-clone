.page { padding-bottom: 160rpx; }

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx 8rpx;
}
.brand { display: flex; align-items: center; }
.logo {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: #d98e8e;
  color: #fff;
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
  margin-right: 14rpx;
}
.gname { font-size: 34rpx; font-weight: 700; color: #4a4038; }
.top-actions { display: flex; gap: 10rpx; }
.top-btn {
  background: #f5f1e9;
  color: #6d675c;
  border-radius: 14rpx;
  padding: 10rpx 18rpx;
  font-size: 25rpx;
}
.top-btn.on { background: #e8e2d6; }
.top-btn.primary { background: #d98e8e; color: #fff; }

.view-seg { margin: 16rpx 30rpx 0; }

.score-scroll { white-space: nowrap; margin-top: 16rpx; }
.score-row { display: inline-flex; padding: 0 30rpx; gap: 12rpx; }
.chip {
  display: inline-block;
  background: #fff;
  border: 1rpx solid #e8e0d4;
  color: #6d675c;
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
  font-size: 25rpx;
}
.chip.on { background: #d98e8e; border-color: #d98e8e; color: #fff; }

.more {
  margin: 16rpx 30rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}
.chan-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.sort-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.sort-label { font-size: 25rpx; color: #8a8378; }

.more-toggle {
  text-align: center;
  color: #8a8378;
  font-size: 25rpx;
  padding: 14rpx 0 0;
}

.search-wrap { padding: 16rpx 30rpx 0; }
.search {
  background: #fff;
  border-radius: 18rpx;
  padding: 16rpx 26rpx;
  font-size: 27rpx;
  border: 1rpx solid #ece5da;
}

.count { color: #8a8378; font-size: 24rpx; padding: 16rpx 30rpx 6rpx; }

.list { padding: 0 30rpx; }
.card {
  display: flex;
  margin-bottom: 20rpx;
}
.thumb {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  background: #f3efe6;
  flex-shrink: 0;
}
.thumb image { width: 100%; height: 100%; }
.ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx;
}
.sel {
  position: absolute;
  top: 10rpx; right: 10rpx;
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,.95);
  background: rgba(255,255,255,.9);
  color: #fff;
  font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.sel.own { background: #7ba05b; }
.sel.cult { background: #c9a227; }
.badge {
  position: absolute;
  top: 10rpx; left: 10rpx;
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  display: flex; align-items: center; justify-content: center;
}
.badge.own { background: rgba(123,160,91,.92); }
.badge.cult { background: rgba(201,162,39,.92); }

.body { flex: 1; padding: 14rpx 18rpx; min-width: 0; }
.line1 { display: flex; align-items: center; gap: 10rpx; }
.nm {
  font-size: 29rpx;
  font-weight: 600;
  color: #3a3530;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.score {
  flex-shrink: 0;
  background: #fdecec;
  color: #c26f6f;
  font-size: 22rpx;
  border-radius: 10rpx;
  padding: 4rpx 10rpx;
}
.line2 {
  font-size: 23rpx;
  color: #8a8378;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.owners {
  font-size: 23rpx;
  color: #a07b2e;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.btn.small { padding: 8rpx 18rpx; font-size: 24rpx; border-radius: 14rpx; }

.batch-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 -4rpx 16rpx rgba(90,70,50,.1);
  z-index: 50;
}
.bcount { font-size: 26rpx; color: #4a4038; flex-shrink: 0; }

.mask {
  position: fixed;
  inset: 0;
  background: rgba(50,40,30,.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx;
}
.mtitle { font-size: 34rpx; font-weight: 700; margin-bottom: 24rpx; }
.mtext {
  width: 100%;
  height: 240rpx;
  background: #f7f4ee;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
}
.mhint { color: #8a8378; font-size: 24rpx; margin: 16rpx 0 24rpx; }
