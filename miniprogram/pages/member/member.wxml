<view class="page">
  <view class="head">
    <view class="seg">
      <view class="it {{mode === 'mine' ? 'on' : ''}}" data-m="mine" bindtap="switchMode">我的</view>
      <view class="it {{mode === 'agg' ? 'on' : ''}} gold" data-m="agg" bindtap="switchMode">全体聚合</view>
    </view>
    <view class="logout" bindtap="logout">退出登录</view>
  </view>

  <!-- 我的：成员卡片列表 -->
  <view class="mlist" wx:if="{{mode === 'mine'}}">
    <view class="mcard" wx:for="{{members}}" wx:key="id">
      <view class="avatar">{{item.name[0]}}</view>
      <view class="minfo">
        <view class="mname">{{item.name}}<text class="me-tag" wx:if="{{item.isMe}}">我</text></view>
        <view class="mrole">{{item.role}}</view>
      </view>
      <view class="mstats">
        <view class="stat"><text class="n">{{item.own}}</text><text class="l">已拥有</text></view>
        <view class="stat"><text class="n gold">{{item.cult}}</text><text class="l">待培育</text></view>
        <view class="stat"><text class="n total">{{item.total}}</text><text class="l">合计</text></view>
      </view>
    </view>
  </view>

  <!-- 全体聚合 -->
  <block wx:else>
    <view class="agg-head">全体成员聚合 · 只读（一行一朵）</view>
    <view class="seg filt">
      <view class="it {{aggFilter === 'all' ? 'on' : ''}}" data-f="all" bindtap="setAggFilter">全部</view>
      <view class="it {{aggFilter === 'have' ? 'on' : ''}}" data-f="have" bindtap="setAggFilter">有人拥有</view>
      <view class="it {{aggFilter === 'cult' ? 'on' : ''}}" data-f="cult" bindtap="setAggFilter">有人待培育</view>
      <view class="it {{aggFilter === 'none' ? 'on' : ''}}" data-f="none" bindtap="setAggFilter">全员未拥有</view>
    </view>
    <view class="count">共 {{aggCount}} 朵</view>
    <view class="agg-list">
      <view class="arow" wx:for="{{aggFlowers}}" wx:key="id">
        <view class="atop">
          <text class="anm">{{item.name}}</text>
          <text class="ascore" wx:if="{{item.score}}">{{item.score}}分</text>
        </view>
        <view class="abg">
          <text wx:for="{{item.badges}}" wx:key="name" class="ab {{item.cls}}">{{item.ch}} {{item.name}}</text>
          <text wx:if="{{item.none}}" class="anone">全员未拥有</text>
        </view>
      </view>
      <view class="empty" wx:if="{{!aggFlowers.length}}">没有符合条件的花</view>
    </view>
  </block>
</view>
