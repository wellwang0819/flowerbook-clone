.page { padding: 24rpx 30rpx 80rpx; }

.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.head .seg { flex: 1; }
.logout {
  color: #c26f6f;
  font-size: 25rpx;
  padding-left: 24rpx;
  flex-shrink: 0;
}

.mlist { display: flex; flex-direction: column; gap: 18rpx; }
.mcard {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(90, 70, 50, 0.06);
}
.avatar {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: #f0e6da;
  color: #a07b2e;
  font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.minfo { flex: 1; padding: 0 24rpx; min-width: 0; }
.mname { font-size: 30rpx; font-weight: 600; }
.me-tag {
  background: #d98e8e;
  color: #fff;
  font-size: 20rpx;
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}
.mrole { font-size: 24rpx; color: #8a8378; margin-top: 4rpx; }
.mstats { display: flex; gap: 20rpx; }
.stat { text-align: center; }
.stat .n { font-size: 28rpx; font-weight: 700; color: #5c8340; }
.stat .n.gold { color: #a07b2e; }
.stat .n.total { color: #4a4038; }
.stat .l { display: block; font-size: 20rpx; color: #a8a197; }

.agg-head { color: #8a8378; font-size: 24rpx; margin-bottom: 16rpx; }
.filt { margin-bottom: 16rpx; }
.count { color: #8a8378; font-size: 24rpx; margin-bottom: 14rpx; }

.agg-list { display: flex; flex-direction: column; gap: 14rpx; }
.arow {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(90, 70, 50, 0.06);
}
.atop { display: flex; align-items: center; gap: 10rpx; }
.anm { font-size: 28rpx; font-weight: 600; }
.ascore {
  background: #fdecec;
  color: #c26f6f;
  font-size: 21rpx;
  border-radius: 10rpx;
  padding: 3rpx 10rpx;
}
.abg { margin-top: 10rpx; }
.ab {
  display: inline-block;
  font-size: 22rpx;
  border-radius: 10rpx;
  padding: 4rpx 12rpx;
  margin: 0 10rpx 8rpx 0;
}
.ab.own { background: #f2f8ec; color: #5c8340; }
.ab.cult { background: #fdf8e9; color: #a07b2e; }
.anone { color: #b5aea4; font-size: 22rpx; }
